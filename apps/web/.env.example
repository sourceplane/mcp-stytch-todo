# Copy to .env.local (never committed): the page's Stytch values, compiled
# into the front end by `vite build` — public by Stytch's design. OPTIONAL:
# without the public token the page says how to connect Stytch. On a
# deployed environment they come from the Orun secrets STYTCH_PUBLIC_TOKEN
# and STYTCH_DOMAIN.
VITE_STYTCH_PUBLIC_TOKEN=
VITE_STYTCH_DOMAIN=
