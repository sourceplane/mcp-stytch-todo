{
  "name": "@app/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "node scripts/dev.mjs",
    "preview": "vite build && wrangler dev",
    "typecheck": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "wire:fixture": "node ../../tooling/wire/render.mjs --template wrangler.template.jsonc --out wrangler.jsonc --map wiring.fixture.json --env stage"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@stytch/react": "20.0.11",
    "agents": "0.29.0",
    "hono": "4.12.27",
    "jose": "6.2.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@app/tsconfig": "workspace:*",
    "@cloudflare/workers-types": "^4.20250508.0",
    "@types/node": "^22.9.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "^9.27.0",
    "typescript": "^5.8.3",
    "vite": "8.1.0",
    "wrangler": "^4.151.0"
  }
}
